#!/usr/bin/env bash
# Manages the manage_my_process daemon (start, stop, restart)

PID_FILE="/var/run/my_process.pid"
PROCESS="./manage_my_process"

case "$1" in
  start)
    sudo "$PROCESS" &
    echo $! | sudo tee "$PID_FILE" > /dev/null
    echo "manage_my_process started"
    ;;
  stop)
    if [ -f "$PID_FILE" ]; then
      sudo kill "$(cat "$PID_FILE")"
      sudo rm -f "$PID_FILE"
    fi
    echo "manage_my_process stopped"
    ;;
  restart)
    if [ -f "$PID_FILE" ]; then
      sudo kill "$(cat "$PID_FILE")"
      sudo rm -f "$PID_FILE"
    fi
    sudo "$PROCESS" &
    echo $! | sudo tee "$PID_FILE" > /dev/null
    echo "manage_my_process restarted"
    ;;
  *)
    echo "Usage: manage_my_process {start|stop|restart}"
    ;;
esac

